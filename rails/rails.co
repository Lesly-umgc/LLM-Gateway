# LNM Gateway — Colang rail definitions.
#
# Executed by NeMo Guardrails' real runtime (LLMRails, see
# rails/nemo_runtime.py) on every request: input rails run before the LLM
# call, output rails after. The Python behind each `execute` step is
# registered as a NeMo action in nemo_runtime.py.
#
# The deterministic prefilter (rails/prefilter.py) runs in the gateway
# before NeMo as a cheap first layer; these rails are the second layer.
# NOTE: the `define bot` texts must stay identical to REFUSAL_INPUT /
# REFUSAL_OUTPUT in rails/nemo_runtime.py — the gateway maps them to 403s.

define bot refuse injection attempt
  "I can't help with that. Your request was blocked by the security gateway because it looks like a prompt-injection or jailbreak attempt."

define bot refuse policy violation
  "I can't help with that. The response was blocked by the security gateway's content-policy rail."

define flow prompt injection defense
  $result = execute nemo_input_judge
  if $result.blocked
    bot refuse injection attempt

define flow jailbreak defense
  $result = execute nemo_input_judge
  if $result.blocked
    bot refuse injection attempt

define flow pii redaction
  $result = execute nemo_redact_output

define flow policy refusal
  $result = execute nemo_policy_check
  if $result.blocked
    bot refuse policy violation
