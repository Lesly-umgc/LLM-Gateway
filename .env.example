# LNM Gateway — example environment. Copy to .env and fill in.
# The Ollama demo path needs NO secrets at all.

# --- gateway ---
LNM_API_KEYS=demo-key-1,demo-key-2      # comma-separated client API keys
LNM_ADMIN_KEY=admin-secret               # for /admin/metrics (defaults to any valid API key)
LNM_RATE_LIMIT_PER_MIN=60
LNM_BACKEND=ollama                       # ollama | gemini | vllm
LNM_AUDIT_PATH=audit.jsonl
LNM_COST_PER_1K_USD=0.0015               # documented blended estimate, used only for est_usd_saved

# --- Ollama backend (primary demo path) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096

# --- rails judges / faithfulness monitor ---
LNM_JUDGE_BACKEND=ollama                 # ollama | gemini | auto
LNM_JUDGE_ENABLED=1                      # 0 = heuristic-only (unit tests)
LNM_FAITHFULNESS_SAMPLE_RATE=0.20
LNM_FAITHFULNESS_THRESHOLD=0.70

# --- token optimizer ---
LNM_CACHE_TTL_SECONDS=3600
LNM_SEM_THRESHOLD=0.95                   # cosine similarity for semantic cache hits
LNM_REDIS_URL=                           # e.g. redis://localhost:6379/0 — enables the shared cache (compose sets this)

# --- Gemini backend (only used if LNM_BACKEND=gemini or judge backend needs it) ---
# Free key from https://aistudio.google.com/apikey — export GEMINI_API_KEY.
# The default ollama backend needs no key at all.
LNM_GEMINI_MODEL=gemini-3.5-flash-lite

# --- vLLM production path (GPU server; see serving/vllm_int8_example.yaml) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=llama3-8b-awq-int8
# VLLM_API_KEY=
